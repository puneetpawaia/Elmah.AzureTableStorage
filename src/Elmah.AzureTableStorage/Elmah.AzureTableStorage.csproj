<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PackageId>Elmah.AzureTableStorage</PackageId>
    <Version>1.0.1</Version>
    <Title>ELMAH on Azure Table Storage</Title>
    <Description>ELMAH error logging using Azure Table Storage.</Description>
    <Authors>Puneet Pawaia</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MisinformedDNA/Elmah.AzureTableStorage</PackageProjectUrl>
    <PackageTags>elmah;azure</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MisinformedDNA/Elmah.AzureTableStorage</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="elmah.corelibrary" />
    <PackageReference Include="Microsoft.WindowsAzure.ConfigurationManager" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <None Update="content/web.config.transform" Pack="true" PackagePath="content/web.config.transform" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
